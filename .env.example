# Arquivo: .env.example (Modelo para configuração)
# NÃO COLOQUE SENHAS REAIS AQUI. COPIE PARA .env e edite.

# --- Banco de Dados (cópia LOCAL — SAT web/AWS não é acessível direto) ---
# PostgreSQL instalado no Windows (recomendado em dev):
BIWEB_DB_MODE=installed
DATABASE_URL=postgresql://postgres:SENHA@localhost:5433/biweb_sati
SATI_DATABASE_URL=postgresql://postgres:SENHA@localhost:5433/biweb_sati
# Dump SATI 1.16+ exige PostgreSQL 16 ou 17:
# SATI_PG_RESTORE=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
# Ou modo instalador .exe: BIWEB_DB_MODE=embedded
# Render: (Será injetado automaticamente pelo render.yaml)
# SaveinCloud: (Será injetado pelas Variáveis de Ambiente da plataforma)
DATABASE_URL=

# Leitura direta do schema SATI c3332 (sem tabelas relFil* importadas)
USE_SATI_SOURCE=true
SATI_SCHEMA=c3332
# Banco SATI (dump restaurado) — use quando DATABASE_URL for dashboard_db:
SATI_DATABASE_URL=postgresql://postgres:SENHA@localhost:5433/sat1_sati_is
# Opcional: restringir a uma filial (codfilial). Deixe vazio para todas.
# SATI_COD_FILIAL=1
# Linux Debian (servidor): caminho explícito se o gunicorn não achar no PATH
# SATI_PG_RESTORE=/usr/lib/postgresql/17/bin/pg_restore
# SATI_ZIP_FILENAME=SATI-c3332-atual.zip
# Servidor Debian sem monitor: use ROBO_HEADLESS=true (ou deixe vazio — Linux sem DISPLAY usa headless)
# ROBO_HEADLESS=true
# EXECUTION_MODE=async
# Robôs em ociosidade (lista do fluxo salva + BD SATI + comprovantes):
# BIWEB_IDLE_MONITOR=true
# BIWEB_IDLE_MINUTES=5
# BIWEB_IDLE_CHECK_MINUTES=2
# BIWEB_IDLE_COOLDOWN_MINUTES=30
# Credenciais do SAT (alternativa à tela Configurações → Robô):
# URL_LOGIN=https://seu-servidor/sitesat2-is/
# USUARIO_ROBO=seu_usuario
# SENHA_ROBO=sua_senha

# Instalação única — uma transportadora por servidor:
# BIWEB_TRANSPORTADORA_NOME=Minha Transportadora Ltda
# BIWEB_TRANSPORTADORA_ID=1
# BIWEB_SKIP_LOGIN=true

# Após apontar DATABASE_URL, crie tabelas do sistema (public):
#   alembic upgrade head
# ou: psql ... -f sql/criar_tabelas_biweb_apartamento.sql  (tabela legada: apartamentos)

# --- Redis ---
# Local (VS Code): redis://localhost:6379/0 (Se estiver rodando Redis localmente)
# Render: (Será injetado automaticamente pelo render.yaml)
# SaveinCloud: (Será injetado pelas Variáveis de Ambiente da plataforma)
REDIS_URL=

# --- Flask ---
# Use uma chave secreta forte e única para produção
SECRET_KEY=gere_uma_chave_forte_aqui
FLASK_ENV=development # Mude para 'production' em Render/SaveinCloud
